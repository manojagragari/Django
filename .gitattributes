# Normalise line endings.
#
# This repository is developed on Windows (core.autocrlf=true) but deployed to
# Linux. Without this file, start.sh is committed with CRLF endings and Render
# fails at boot with "bash\r: No such file or directory".
* text=auto eol=lf

# Shell scripts must always be LF, they are executed by the host.
*.sh text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.sqlite3 binary
